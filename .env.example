# --- Host ports (change if something else on your machine already uses them) ---
TIREK_FRONTEND_PORT=3000
TIREK_BACKEND_PORT=8010
TIREK_MAILPIT_PORT=8025

# --- Backend (Django) ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://tirek:tirek@db:5432/tirek
REDIS_URL=redis://redis:6379/0

# Frontend origin(s) allowed for CORS / CSRF (must match TIREK_FRONTEND_PORT)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private file storage.
# Dev: filesystem in a docker volume, files streamed by the backend after an access check.
STORAGE_BACKEND=filesystem
PRIVATE_MEDIA_ROOT=/data/private
# Production: S3-compatible bucket with short-lived signed links
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.example.kz
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=tirek-private
# S3_REGION=us-east-1
# S3_SIGNED_URL_TTL=300

# Email (open Mailpit to read invites and password resets)
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Tirek <no-reply@tirek.local>
FRONTEND_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE_MB=25

# --- Frontend (Next.js) ---
# Server-side URL used by Next.js to reach the API inside the docker network
API_INTERNAL_URL=http://backend:8000

# --- Postgres container ---
POSTGRES_DB=tirek
POSTGRES_USER=tirek
POSTGRES_PASSWORD=tirek
